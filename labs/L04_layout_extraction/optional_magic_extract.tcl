# UNEXECUTED EXTENSION. Requires a genuine user-created native layout and an
# installed compatible SKY130 Magic startup configuration supplied via -rcfile.
# The shipped Lab 4 results were NOT generated by this script.
# Command references checked 2026-11-06. Use a compatible current Magic version;
# inspected open-pdks tech c6df28c1... requires Magic >= 8.3.693.
if {![info exists env(L04_CELL)] || ![info exists env(L04_EXTRACT_STYLE)]} {
    error "Set L04_CELL to your native .mag file and L04_EXTRACT_STYLE to an installed RC extraction style."
}
if {![file exists $env(L04_CELL)]} {
    error "The supplied native layout file does not exist. JSON/SVG are not Magic layout inputs."
}
load $env(L04_CELL)
extract style $env(L04_EXTRACT_STYLE)
extract path .
extresist threshold 0
extresist minres 0
extresist mindelay 0
extresist simplify off
extract do capacitance
extract do coupling
extract do resistance
extract all
ext2spice format ngspice
ext2spice cthresh 0
ext2spice extresist on
ext2spice -p .
puts "Extraction template completed. Inspect ports, models, coupling, and probe mapping before simulation."
quit -noprompt
